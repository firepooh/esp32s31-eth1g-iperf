# ESP32-S31-Function-CoreBoard-1 (ESP32-S31-WROOM-3: 16 MB flash) - 1G Ethernet iperf test
CONFIG_IDF_TARGET="esp32s31"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168

# Flash / partitions (console history on FAT)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Quad I/O flash reads (XMC 0x46 flash on WROOM-3). 80 MHz is the S31 maximum.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_example.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_example.csv"

# Console (REPL + logs) on UART0 (USB-UART bridge port).
# Logs are mirrored to the USB Serial/JTAG port as an output-only secondary console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# 'tasks' command
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# --------------------------------
# Performance
# --------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# Dual core (default): the configuration most applications use.
# Set to y for the highest throughput: single core is up to 29 % faster (see README).
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
CONFIG_ETH_IRAM_OPTIMIZATION=y

# EMAC DMA: one 1600 B descriptor per frame (must be 64 B aligned on S31)
CONFIG_ETH_DMA_BUFFER_SIZE=1600
CONFIG_ETH_DMA_RX_BUFFER_NUM=30
CONFIG_ETH_DMA_TX_BUFFER_NUM=30
# Send pause frames when free RX descriptors run low. Flow control is switched on at
# boot in eth_s31.c (console: `ethernet flowctrl on|off`); needs a pause-capable link partner.
CONFIG_ETH_SOFT_FLOW_CONTROL=y

# lwIP windows / mailboxes sized for gigabit
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# iperf
CONFIG_IPERF_DEF_TCP_TX_BUFFER_LEN=16384
CONFIG_IPERF_DEF_TCP_RX_BUFFER_LEN=16384
CONFIG_IPERF_DEF_UDP_RX_BUFFER_LEN=16384
CONFIG_IPERF_DEF_SOCKET_ACCEPT_TIMEOUT=120
